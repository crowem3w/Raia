<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">


    <ImageView
        android:id="@+id/fragment_onboarding_0"
        android:layout_width="200dp"
        android:layout_height="120dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="4dp"
        android:layout_marginTop="24dp"
        android:scaleType="centerCrop"
        android:background="#E6E0E9"
        android:contentDescription="@string/fragment_onboarding_label_0" />

    <TextView
        android:id="@+id/fragment_onboarding_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="136dp"
        android:layout_marginTop="292dp"
        android:textSize="13sp"
        android:text="@string/fragment_onboarding_label_1" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/fragment_onboarding_2"
        android:layout_width="140dp"
        android:layout_height="56dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="142dp"
        android:layout_marginTop="642dp"
        android:textSize="13sp"
        android:text="@string/fragment_onboarding_label_2" />
</FrameLayout>
