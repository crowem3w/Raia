<?xml version="1.0" encoding="utf-8"?>
<!--
    The bottom nav bar "sheet": a fully rounded pill so both ends read as a single continuous
    strip of material (as opposed to the old top-rounded/bottom-flat dock). The vertical gradient
    plus the 1dp translucent-white stroke stand in for the sheet's ~2px edge/thickness catching a
    soft top-down light, and the rounded-rect shape gives the platform an outline to cast a real
    elevation shadow (see android:elevation on bottomNavBar) so the whole pill reads as a thin
    material sheet floating just above the canvas.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="32dp" />
    <gradient
        android:angle="270"
        android:startColor="#2A2B38"
        android:endColor="#131319" />
    <stroke
        android:width="1dp"
        android:color="#1FFFFFFF" />
</shape>
