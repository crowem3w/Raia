<?xml version="1.0" encoding="utf-8"?>
<!--
    Floating pill-shaped bottom nav bar, drawn to read as a 2px-thick 3D sheet:

    1. "edge" layer - a solid, darker stadium shape that fills the whole bounds. Because the
       "face" layer above it is inset 2dp off the bottom, this layer peeks out as a slim strip
       along the bottom, reading as the visible cut edge of a sheet with real thickness.
    2. "face" layer - the top surface of the sheet: a subtle top-to-bottom gradient (lighter at
       the top where light would catch a curved/beveled sheet, darker toward the bottom edge)
       plus a hairline highlight stroke to sell a raised, lit-from-above panel rather than a
       flat-colored rectangle.

    Corner radius is set larger than half the bar's height so it always resolves to a true
    stadium/pill (Android clamps radius to min(width,height)/2 automatically).
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Edge / thickness layer -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0A0A12" />
            <corners android:radius="100dp" />
        </shape>
    </item>

    <!-- Top face layer, inset off the bottom so 2dp of the edge layer shows beneath it -->
    <item android:bottom="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#22232F"
                android:centerColor="#191A24"
                android:endColor="#131319"
                android:type="linear" />
            <corners android:radius="100dp" />
            <stroke
                android:width="1dp"
                android:color="#33FFFFFF" />
        </shape>
    </item>

</layer-list>
