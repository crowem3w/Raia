<?xml version="1.0" encoding="utf-8"?>
<!-- Cosmetic-only overlay for the floating nav dock (see bottomNavBar.foreground in
     SketchActivity#styleNavDock). Drawn on top of the dock's plain GradientDrawable background,
     which is left alone so its rounded-rect outline still drives a clean elevation shadow.
     Two layers: a soft light gradient hugging the upper edge (the "milky" glass highlight) and a
     hairline translucent stroke tracing the whole capsule for edge definition. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="40dp" />
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="#4DFFFFFF"
                android:centerColor="#12FFFFFF"
                android:endColor="#00FFFFFF"
                android:centerY="0.16" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="40dp" />
            <stroke
                android:width="1dp"
                android:color="#28FFFFFF" />
        </shape>
    </item>
</layer-list>
